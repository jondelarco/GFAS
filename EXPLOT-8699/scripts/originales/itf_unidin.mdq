		<QUERY name="P_OBTENER_203_1606">
			<SQLStmt>call UNIDINADM.PK_ITF_203_1606.P_OBTENER_203_1606(#MSGID#,?,?,?)</SQLStmt>
		</QUERY>
		<QUERY name="P_OBT_203_1633">
			<SQLStmt>call ITFCOLADM.PK_ITF_203_1633.P_OBT_203_1633(#MSGID#,#NEGOCIO#,?,?,?)</SQLStmt>
		</QUERY>
		<QUERY name="P_OBT_COM_OUTBOX">
			<SQLStmt>SELECT   o.SECUENCIA,
         o.COD_INT,
         o.CONTENIDO.getClobVal (),
         o.FLG_ESTADO,
         o.COD_ERROR,
         o.MSG_ERROR,
         o.FEC_EMISION,
         o.FEC_TRATO,
         o.MSGID,
         o.FLG_ORDEN,
         o.APP_ORIGEN,
         o.USUARIO,
         o.PROCESO,
         o.ZIP_CONTENIDO,
         cod_aplicacion_B cod_aplicacion       
  FROM   com_outbox o,
         (SELECT   secuencia secuencia_B,
                   TO_NUMBER(EXTRACT (
                                destinos,
                                '/DESTINOS/DESTINO/APLICACIONES/COD_APLICACION/text()',
                                'xmlns="http://xml.eroski.es/CEBI/schema/CEBI_DESTINOSV1.0"'
                             ).getstringval ())
                      AS cod_aplicacion_B
            FROM   com_outbox) s_y_c,
         com_int_apl_dest ciad
 WHERE       o.secuencia = secuencia_B
         AND o.flg_estado = 'P'
         AND ciad.cod_int = o.cod_int
         AND ciad.cod_destino = 2
         AND ciad.cod_aplicacion = cod_aplicacion_B
         AND cod_aplicacion = #APLICACION#
         AND o.cod_int = #COD_INT#
order by secuencia asc</SQLStmt>
		</QUERY>
		<QUERY name="QUERY_MONTAJES">
			<SQLStmt>SELECT TO_CHAR (SYSDATE, 'YYYYMMDD'), cod_centro,cod_art,TO_CHAR (fecha_inicio, 'YYYYMMDD'),TO_CHAR (fecha_fin, 'YYYYMMDD'),cantidad FROM MISUMIADM.T_MIS_MONTAJES_VEGALSA WHERE fecha_fin &gt;= SYSDATE
</SQLStmt>
		</QUERY>
		<QUERY name="QUERY_DETALLADO">
			<SQLStmt>SELECT TO_CHAR(T.FECHA_PEDIDO,'YYYYMMDD'), T.COD_CENTRO,T.COD_ART,T.CANTIDAD
FROM t_mis_detallado_vegalsa_modif T
WHERE FECHA_PEDIDO = TRUNC(SYSDATE)
AND HORA_LIMITE &lt;  #HORA#
AND FLG_ENVIADO_VEGALSA='N'
AND CANTIDAD &lt;&gt; CANTIDAD_PROPUESTA</SQLStmt>
		</QUERY>
